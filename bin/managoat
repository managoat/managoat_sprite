#!/usr/bin/env python3
"""Managoat CLI: provisioning on your computer, service management on a Sprite."""
from pathlib import Path
import sys

root = Path(__file__).resolve().parent.parent
source = root / 'scripts'
if not (source / 'managoat.py').is_file():
    source = root / 'lib/managoat-cli'
sys.path.insert(0, str(source))
from managoat import entrypoint
entrypoint()
