{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manasprites",
  "version": "0.1.0",
  "identifier": "com.managoat.manasprites",
  "build": {
    "beforeBuildCommand": "sh scripts/prepare-release.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [{
        "identifier": "agent-card-clipboard",
        "windows": ["main"],
        "local": false,
        "remote": {"urls": ["http://127.0.0.1:*"]},
        "permissions": ["allow-copy-agent-card-url"]
      }]
    }
  },
  "bundle": {
    "active": true,
    "resources": {"target/rel": "rel"},
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {"minimumSystemVersion": "15.0", "entitlements": "App.entitlements", "signingIdentity": "-"}
  }
}
